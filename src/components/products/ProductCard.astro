---
interface Props {
  title: string;
  description: string;
  price?: string;
  href: string;
  cta: string;
  badge?: string;
}

const { title, description, price, href, cta, badge } = Astro.props as Props;
---

<a
  href={href}
  class="noise group flex flex-col rounded-2xl border border-base-content/10 bg-base-100/5 p-6 transition hover:border-primary"
>
  {badge && <span class="badge badge-primary badge-sm self-start mb-3">{badge}</span>}
  <h3 class="text-lg font-bold">{title}</h3>
  <p class="mt-2 flex-1 text-sm text-base-content/70">{description}</p>
  <div class="mt-4 flex items-center justify-between">
    {price ? <span class="font-mono font-semibold text-primary">{price}</span> : <span />}
    <span class="btn btn-primary btn-sm">{cta}</span>
  </div>
</a>
