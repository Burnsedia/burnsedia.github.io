<section class="w-full flex flex-col items-center justify-center py-12">
  <h2 class="text-2xl sm:text-4xl font-bold tracking-tight text-center text-base-content mb-10">
    What Clients Say
  </h2>
  <div id="testimonial-carousel" class="relative w-full max-w-3xl overflow-hidden rounded-box">
    <div class="flex transition-transform duration-700 ease-in-out" id="carousel-track">
      <!-- Each card -->
      <div class="flex-none w-full flex justify-center px-4">
        <div class="border border-primary backdrop-blur card p-6 max-w-xl text-center">
          <p class="italic">
            “Bailey Burnsed created a landing page and facilitated process ideation for my app idea. Flexible, wonderful to work with, and has a wicked sense of humor.”
          </p>
          <p class="mt-4 font-semibold">— Sylvia Pace</p>
        </div>
      </div>
      <div class="flex-none w-full flex justify-center px-4">
        <div class="border border-primary backdrop-blur card p-6 max-w-xl text-center">
          <p class="italic">
            “Bailey has given great advice in seeing what works in my next pursuit. He dissects problems quickly and gives proper solutions.”
          </p>
          <p class="mt-4 font-semibold">— ST</p>
        </div>
      </div>
      <div class="flex-none w-full flex justify-center px-4">
        <div class="border border-primary backdrop-blur card p-6 max-w-xl text-center">
          <p class="italic">
            “It is with great pleasure that I officially hired an amazing full-stack developer, Bailey Burnsed. He has shown himself to be very knowledgeable and skilled, comprehending the needs of his clients and bringing their vision to reality.”
          </p>
          <p class="mt-4 font-semibold">— AJ, Limelite.live</p>
        </div>
      </div>
    </div>
  </div>
  <div class="flex justify-center gap-2 mt-6">
    <button class="btn btn-xs btn-primary" id="prev">‹</button>
    <button class="btn btn-xs btn-primary" id="next">›</button>
  </div>
</section>
<script>
  const init = () => {
    const trackEl = document.getElementById("carousel-track");
    if (!trackEl) return;
    let index = 0;
    const slides = trackEl.children.length;
    const style = trackEl.style;

    function showSlide(i: number) {
      index = (i + slides) % slides;
      style.transform = `translateX(-${index * 100}%)`;
    }

    const prev = document.getElementById("prev");
    const next = document.getElementById("next");
    prev?.setAttribute("aria-label", "previous testimonial");
    next?.setAttribute("aria-label", "next testimonial");
    prev?.addEventListener("click", () => showSlide(index - 1));
    next?.addEventListener("click", () => showSlide(index + 1));

    // Auto-slide every 6 s
    setInterval(() => showSlide(index + 1), 6000);
  };

  init();
</script>
