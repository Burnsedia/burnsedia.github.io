---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/legacy/FormattedDate.astro';
import NewsletterCtaCard from '../components/shared/NewsletterCtaCard.astro';
import HowToSchema from '../components/shared/HowToSchema.astro';
import { SITE_TITLE } from '../consts';
import { getEntrySlug } from '../utils/content';
import { getNormalizedTags, getTagLabel } from '../utils/tags';
import BaseLayout from './BaseLayout.astro';

type RelatedPost = CollectionEntry<'blog'>;

export interface Props {
  slug: string;
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  faq?: { question: string; answer: string }[];
  schema?: 'article' | 'howto';
  steps?: { name: string; text: string; image?: string }[];
  relatedPosts?: RelatedPost[];
}

const {
  slug,
  title,
  description,
  seoTitle,
  seoDescription,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  faq = [],
  schema = 'article',
  steps = [],
  relatedPosts = [],
} = Astro.props;

const pageTitle = seoTitle || title;
const pageDescription = seoDescription || description;

const normalizedTags = getNormalizedTags(tags);
const baseUrl = Astro.site?.toString() ?? 'https://baileyburnsed.dev';
const toAbsoluteUrl = (path: string) => new URL(path, baseUrl).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: toAbsoluteUrl('/'),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: toAbsoluteUrl('/blog/'),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: toAbsoluteUrl(`/blog/${slug}/`),
    },
  ],
};
---
<BaseLayout
  title={`${pageTitle} | ${SITE_TITLE}`}
  description={pageDescription}
  image={heroImage}
  type="article"
  canonical={`/blog/${slug}/`}
  publishedTime={pubDate.toISOString()}
  updatedTime={updatedDate ? updatedDate.toISOString() : undefined}
  tags={tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    })} />
  )}
  {schema === 'howto' && steps.length > 0 && (
    <HowToSchema name={pageTitle} description={pageDescription} steps={steps} />
  )}
  <article class="w-full">
  <!-- Exact same padded container as your Legal page -->
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    {heroImage && (
      <img 
        class="w-full max-w-4xl mx-auto rounded-md shadow-lg mask mask-hexagon mt-25" 
        src={heroImage} 
        alt={title} 
      />
    )}
    <h1 class="title py-4 text-3xl md:text-4xl lg:text-5xl text-center">{title}</h1>
    <div class="text-center">
      <FormattedDate date={pubDate} />
      {updatedDate && <div class="last-updated-on">Last updated on <FormattedDate date={updatedDate} /></div>}
    </div>
    {normalizedTags.length > 0 && (
      <div class="mt-4 mb-2 flex flex-wrap justify-center gap-2">
        {normalizedTags.map((tag) => (
          <a class="badge badge-outline badge-sm hover:badge-primary" href={`/tags/${tag}/`}>
            {getTagLabel(tag)}
          </a>
        ))}
      </div>
    )}
    <!-- Markdown content now matches Legal page spacing perfectly -->
    <div class="blog-content">
      <slot />
    </div>
    <!-- All your existing sections (newsletter, work-with-me, related posts) stay inside the padded container -->
    <section class="mt-8">
      <NewsletterCtaCard placement="blog_post_end_newsletter" source="blog_post" />
    </section>
    <section class="mt-6 rounded-2xl border border-base-content/10 bg-base-100/5 p-6">
      <h2 class="text-2xl font-bold">Need help shipping this faster?</h2>
      <p class="mt-2 text-base-content/80">I work with founders and teams to ship practical systems with clear tradeoffs and clean ownership.</p>
      <a
        class="btn btn-outline btn-primary mt-4"
        href="/service"
        data-track-event="work_with_me_click"
        data-track-source="blog_post"
        data-track-placement="blog_post_end_work_with_me"
        data-track-label="work-with-me"
      >
        Work With Me
      </a>
    </section>
    {relatedPosts.length > 0 && (
      <section class="mt-10 border-t border-base-300 pt-6">
        <h2 class="text-2xl font-bold mb-4">Related reads</h2>
        <ul class="space-y-3">
          {relatedPosts.map((relatedPost) => (
            <li>
              <a class="link link-hover font-semibold" href={`/blog/${getEntrySlug(relatedPost.id)}/`}>
                {relatedPost.data.title}
              </a>
              <p class="text-sm text-base-content/80">{relatedPost.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</article>

<script is:inline>
  (() => {
    if (window.location.hostname !== 'baileyburnsed.dev') {
      return;
    }

    const gtag = window.gtag;
    if (typeof gtag !== 'function') {
      return;
    }

    const pagePath = window.location.pathname;

    const depthMarks = [25, 50, 75, 100];
    const fired = new Set();

    const trackScrollDepth = () => {
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - window.innerHeight;

      if (scrollable <= 0) {
        return;
      }

      const percent = Math.round((window.scrollY / scrollable) * 100);

      depthMarks.forEach((mark) => {
        if (percent >= mark && !fired.has(mark)) {
          fired.add(mark);
          gtag('event', 'scroll_depth', {
            event_category: 'engagement',
            event_label: `${mark}%`,
            page_path: pagePath,
          });
        }
      });
    };

    let scrollTicking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollTicking) {
          window.requestAnimationFrame(() => {
            trackScrollDepth();
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      },
      { passive: true }
    );

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element
        ? event.target.closest('[data-track-event]')
        : null;

      if (!target) {
        return;
      }

      gtag('event', target.getAttribute('data-track-event'), {
        event_category: 'engagement',
        event_label: target.getAttribute('data-track-label') || undefined,
        source: target.getAttribute('data-track-source') || undefined,
        placement: target.getAttribute('data-track-placement') || undefined,
        page_path: pagePath,
      });
    });
  })();
</script>
</BaseLayout>
